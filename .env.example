# Docker Compose configuration. Copy to .env at the repository root.
# Local demo values only; generate your own secrets for any hosted environment.
JWT_SECRET=local-development-jwt-secret-change-me
WEBHOOK_SECRET=local-development-webhook-secret-change-me
PAYMENT_RATE_LIMIT=200

# Optional for auth/wallet browsing, required for successful payment creation.
# Use your own Stripe test/sandbox secret key; never use live keys for this demo.
STRIPE_SECRET_KEY=
# Copy the whsec_ value printed by your local `stripe listen` command.
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel
