# ---- Build stage ----
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency configs first to cache node_modules installation
COPY package.json package-lock.json ./
RUN npm ci

# Copy full source
COPY . .
RUN npm run build

# ---- Runtime stage ----
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Standalone output includes its own node_modules — no separate install needed.
# public/ and static assets must be copied explicitly.
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

LABEL version="3"
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# server.js is the entry point generated by `output: "standalone"`.
# It respects the PORT environment variable set by Railway.
CMD ["node", "server.js"]

