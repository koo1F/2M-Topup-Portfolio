# Local Go development. The Go processes read environment variables,
# not .env files automatically; export these before running.
DATABASE_URL=postgres://user:password@localhost:5432/payment_db?sslmode=disable
REDIS_URL=localhost:6379
JWT_SECRET=local-development-jwt-secret-change-me
WEBHOOK_SECRET=local-development-webhook-secret-change-me
PORT=8080
PAYMENT_RATE_LIMIT=200
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel
